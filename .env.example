# GolpoGhor environment variables.
# Copy to .env and fill in. NEVER commit real keys.
#
# Without these values the app runs in local demo mode (data stays in the
# browser). Set them to use a real Supabase project.

# Supabase project URL, e.g. https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase *anon* (public) key. Safe for browser use ONLY because Row-Level
# Security enforces authorization in the database. The service-role key must
# NEVER be placed here or shipped to browsers.
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Cloudflare Turnstile site key for signup / sign-in / password-reset
# CAPTCHA (optional). Leave unset to keep today's behaviour exactly:
# no widget renders and no token is sent. When set, the matching secret
# goes in Supabase Auth settings — and the dashboard CAPTCHA toggle goes
# ON only AFTER this build is deployed and a real signup is tested, since
# enabling it first breaks all signups/sign-ins.
# VITE_TURNSTILE_SITE_KEY=
