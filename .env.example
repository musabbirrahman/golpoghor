# GolpoGhor environment variables.
# Copy to .env and fill in. NEVER commit real keys.
#
# Without these values the app runs in local demo mode (data stays in the
# browser). Set them to use a real Supabase project.

# Supabase project URL, e.g. https://xyzcompany.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase *anon* (public) key. Safe for browser use ONLY because Row-Level
# Security enforces authorization in the database. The service-role key must
# NEVER be placed here or shipped to browsers.
VITE_SUPABASE_ANON_KEY=your-public-anon-key
